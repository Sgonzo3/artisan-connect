# From https://dashboard.linqapp.com/sandbox-signup
LINQ_API_KEY=your_bearer_token_here
LINQ_PHONE_NUMBER=+1XXXXXXXXXX

# Filled in automatically by `npm run subscribe` (signing secret from create response)
LINQ_WEBHOOK_SECRET=

# Where drafted appointment summaries are sent (E.164)
BOOKING_NOTIFY_NUMBER=+16469434074

# Optional
PORT=3000
# Public HTTPS URL for webhooks (set by `npm run start:tunnel`, or paste your own)
PUBLIC_WEBHOOK_URL=
